{
  // Staging Worker for the read-only feasibility slice. It has no route and no
  // custom domain: deploying it cannot change production routing, which still
  // serves the static client from GitHub Pages and the API from Apps Script.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "volunteer-scheduling-staging",
  "main": "src/worker/entry.ts",
  // Pinned to the newest compatibility date the pinned local toolchain's workerd
  // implements, so `npm run test:worker` exercises the same runtime behaviour the
  // deployed Worker is pinned to instead of silently falling back.
  "compatibility_date": "2026-03-10",
  "workers_dev": true,
  "observability": { "enabled": true },
  "vars": {
    // Local development and Worker-native tests only. The deployed origin
    // allowlist is set per environment by the staging manifest (task 3.1); an
    // empty list denies every request that sends an Origin header.
    "STAGING_ALLOWED_ORIGINS": "http://localhost:8788"
  },
  "env": {
    "staging": {
      // Named environment: `wrangler deploy --env staging`. Every binding the
      // slice needs is listed here so a deploy cannot silently omit one; each
      // REPLACE_ value is a placeholder that fails validation, which makes the
      // endpoint refuse (503) instead of serving with guessed configuration.
      // Secrets are supplied with `wrangler secret put --env staging`.
      "vars": {
        "STAGING_ALLOWED_ORIGINS": "REPLACE_WITH_THE_STAGING_ORIGIN",
        "STAGING_OAUTH_AUDIENCE": "REPLACE_WITH_THE_STAGING_OAUTH_CLIENT_ID",
        "STAGING_WORKBOOK_ID": "REPLACE_WITH_THE_STAGING_SPREADSHEET_ID",
        "STAGING_WORKBOOK_TIME_ZONE": "REPLACE_WITH_THE_SPREADSHEET_TIME_ZONE",
        "STAGING_TIME_ZONE": "America/Chicago",
        "STAGING_DISPLAY_INCREMENT_MINUTES": "30",
        "STAGING_OPERATING_HOURS_START": "09:00",
        "STAGING_OPERATING_HOURS_END": "21:00",
        "STAGING_DATA_REVISION": "REPLACE_WITH_THE_FIXTURE_REVISION",
        "STAGING_SCHEDULING_INPUT_REVISION": "REPLACE_WITH_THE_FIXTURE_INPUT_REVISION",
        "STAGING_TAB_REVISIONS": "REPLACE_WITH_A_JSON_OBJECT_OF_TAB_REVISIONS",
        "GOOGLE_SERVICE_ACCOUNT_EMAIL": "REPLACE_WITH_THE_READ_ONLY_SERVICE_ACCOUNT"
      }
    }
  }
}
